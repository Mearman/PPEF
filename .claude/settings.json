{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "deny": [
      "Bash(git add -A)",
      "Bash(git add --all)",
      "Bash(git add .)",
      "Bash(git add -u)",
      "Bash(git add --update)",
      "Bash(git commit -n*)",
      "Bash(git commit --no-verify*)",
      "Write(*ppef.schema.json)",
      "Edit(*ppef.schema.json)"
    ]
  }
}
