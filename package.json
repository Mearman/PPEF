{
  "name": "ppef",
  "version": "1.2.1",
  "description": "Portable Programmatic Evaluation Framework - Claim-driven, deterministic evaluation for experiments",
  "type": "module",
  "main": "dist/index.cjs",
  "module": "dist/index.js",
  "types": "dist/index.d.ts",
  "bin": {
    "ppef": "./bin/ppef.mjs"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./types": {
      "types": "./dist/types/index.d.ts",
      "import": "./dist/types/index.js"
    },
    "./types/*": {
      "types": "./dist/types/*.d.ts",
      "import": "./dist/types/*.js"
    },
    "./registry": {
      "types": "./dist/registry/index.d.ts",
      "import": "./dist/registry/index.js"
    },
    "./registry/*": {
      "types": "./dist/registry/*.d.ts",
      "import": "./dist/registry/*.js"
    },
    "./executor": {
      "types": "./dist/executor/index.d.ts",
      "import": "./dist/executor/index.js"
    },
    "./executor/*": {
      "types": "./dist/executor/*.d.ts",
      "import": "./dist/executor/*.js"
    },
    "./collector": {
      "types": "./dist/collector/index.d.ts",
      "import": "./dist/collector/index.js"
    },
    "./collector/*": {
      "types": "./dist/collector/*.d.ts",
      "import": "./dist/collector/*.js"
    },
    "./statistical": {
      "types": "./dist/statistical/index.d.ts",
      "import": "./dist/statistical/index.js"
    },
    "./aggregation": {
      "types": "./dist/aggregation/index.d.ts",
      "import": "./dist/aggregation/index.js"
    },
    "./aggregation/*": {
      "types": "./dist/aggregation/*.d.ts",
      "import": "./dist/aggregation/*.js"
    },
    "./claims": {
      "types": "./dist/claims/index.d.ts",
      "import": "./dist/claims/index.js"
    },
    "./claims/*": {
      "types": "./dist/claims/*.d.ts",
      "import": "./dist/claims/*.js"
    },
    "./robustness": {
      "types": "./dist/robustness/index.d.ts",
      "import": "./dist/robustness/index.js"
    },
    "./robustness/*": {
      "types": "./dist/robustness/*.d.ts",
      "import": "./dist/robustness/*.js"
    },
    "./renderers": {
      "types": "./dist/renderers/index.d.ts",
      "import": "./dist/renderers/index.js"
    },
    "./renderers/*": {
      "types": "./dist/renderers/*.d.ts",
      "import": "./dist/renderers/*.js"
    }
  },
  "files": [
    "dist",
    "ppef.schema.json"
  ],
  "sideEffects": false,
  "engines": {
    "node": ">=18"
  },
  "c8": {
    "all": true,
    "include": [
      "src/**/*.ts"
    ],
    "exclude": [
      "src/**/*.test.ts",
      "src/**/*.spec.ts",
      "src/**/*.diagnostic.test.ts"
    ],
    "reporter": [
      "text",
      "html",
      "json-summary"
    ],
    "reports-dir": "coverage"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "lint": "eslint 'src/**/!(__tests__)/**/*.ts' --fix",
    "test": "c8 tsx --test src/**/*.test.ts src/**/**/*.test.ts",
    "build": "tsc && tsx scripts/generate-cjs-wrapper.ts && tsx scripts/generate-json-schema.ts",
    "prepare": "husky"
  },
  "keywords": [
    "evaluation",
    "framework",
    "testing",
    "experiments",
    "claims-driven"
  ],
  "author": "Joseph Mearman",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Mearman/ppef.git"
  },
  "release": {
    "branches": [
      "main"
    ],
    "plugins": [
      [
        "@semantic-release/commit-analyzer",
        {
          "preset": "conventionalcommits",
          "releaseRules": [
            {
              "type": "feat",
              "release": "minor"
            },
            {
              "type": "fix",
              "release": "patch"
            },
            {
              "type": "perf",
              "release": "patch"
            },
            {
              "type": "refactor",
              "release": "patch"
            },
            {
              "type": "docs",
              "release": "patch"
            },
            {
              "type": "style",
              "release": "patch"
            },
            {
              "type": "test",
              "release": "patch"
            },
            {
              "type": "build",
              "release": "patch"
            },
            {
              "type": "ci",
              "release": "patch"
            },
            {
              "type": "chore",
              "release": "patch"
            },
            {
              "type": "revert",
              "release": "patch"
            }
          ]
        }
      ],
      [
        "@semantic-release/release-notes-generator",
        {
          "preset": "conventionalcommits",
          "presetConfig": {
            "types": [
              {
                "type": "feat",
                "section": "Features"
              },
              {
                "type": "fix",
                "section": "Bug Fixes"
              },
              {
                "type": "perf",
                "section": "Performance Improvements"
              },
              {
                "type": "refactor",
                "section": "Code Refactoring"
              },
              {
                "type": "docs",
                "section": "Documentation"
              },
              {
                "type": "style",
                "section": "Styles"
              },
              {
                "type": "test",
                "section": "Tests"
              },
              {
                "type": "build",
                "section": "Build System"
              },
              {
                "type": "ci",
                "section": "Continuous Integration"
              },
              {
                "type": "chore",
                "section": "Chores"
              },
              {
                "type": "revert",
                "section": "Reverts"
              }
            ]
          }
        }
      ],
      "@semantic-release/changelog",
      "@semantic-release/npm",
      [
        "@semantic-release/git",
        {
          "assets": [
            "CHANGELOG.md",
            "package.json"
          ],
          "message": "chore(release): ${nextRelease.version} [skip ci]\n\n${nextRelease.notes}"
        }
      ]
    ]
  },
  "lint-staged": {
    "*.ts": [
      "eslint --fix"
    ],
    "*.js": [
      "eslint --fix"
    ]
  },
  "devDependencies": {
    "@commitlint/cli": "20.3.1",
    "@commitlint/config-conventional": "20.3.1",
    "@eslint-community/eslint-plugin-eslint-comments": "4.6.0",
    "@eslint/js": "9.39.2",
    "@eslint/markdown": "7.5.1",
    "@semantic-release/changelog": "6.0.3",
    "@semantic-release/git": "10.0.1",
    "@types/node": "25.0.10",
    "c8": "10.1.3",
    "eslint": "9.39.2",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-jsonc": "2.21.0",
    "eslint-plugin-prettier": "5.5.5",
    "husky": "9.1.7",
    "jiti": "2.6.1",
    "lint-staged": "16.2.7",
    "prettier": "3.8.1",
    "semantic-release": "25.0.2",
    "tsx": "4.21.0",
    "typescript": "5.9.3",
    "typescript-eslint": "8.53.1"
  },
  "peerDependencies": {
    "typescript": "5.0.0"
  },
  "dependencies": {
    "commander": "^12.0.0",
    "zod": "^4.3.6"
  },
  "publishConfig": {
    "provenance": true
  }
}
