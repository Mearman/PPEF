    "MetricsEvaluatorConfig": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "type": "object",
      "properties": {
        "name": {
          "description": "Human-readable evaluator name",
          "type": "string"
        },
        "description": {
          "description": "Evaluator description",
          "type": "string"
        },
        "options": {
          "description": "Additional evaluator-specific options",
          "type": "object",
          "propertyNames": {
            "type": "string"
          },
          "additionalProperties": {}
        },
        "criteria": {
          "minItems": 1,
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "criterionId": {
                "type": "string",
                "minLength": 1,
                "description": "Unique criterion identifier"
              },
              "description": {
                "type": "string",
                "minLength": 1,
                "description": "Human-readable description"
              },
              "type": {
                "type": "string",
                "enum": [
                  "threshold",
                  "baseline",
                  "target-range"
                ],
                "description": "Type of metrics criterion"
              },
              "metric": {
                "type": "string",
                "minLength": 1,
                "description": "Metric to evaluate"
              },
              "sut": {
                "type": "string",
                "minLength": 1,
                "description": "SUT to evaluate (or \"*\" for all SUTs)"
              },
              "threshold": {
                "description": "Threshold operator and value (required when type is threshold)",
                "type": "object",
                "properties": {
                  "operator": {
                    "type": "string",
                    "enum": [
                      "gt",
                      "gte",
                      "lt",
                      "lte",
                      "eq"
                    ],
                    "description": "Comparison operator"
                  },
                  "value": {
                    "type": "number",
                    "description": "Threshold value"
                  }
                },
                "required": [
                  "operator",
                  "value"
                ],
                "additionalProperties": false
              },
              "baseline": {
                "description": "Baseline comparison (required when type is baseline)",
                "type": "object",
                "properties": {
                  "sut": {
                    "type": "string",
                    "minLength": 1,
                    "description": "Baseline SUT identifier"
                  },
                  "operator": {
                    "type": "string",
                    "enum": [
                      "gt",
                      "gte",
                      "lt",
                      "lte",
                      "eq"
                    ],
                    "description": "Comparison operator"
                  }
                },
                "required": [
                  "sut",
                  "operator"
                ],
                "additionalProperties": false
              },
              "targetRange": {
                "description": "Target range (required when type is target-range)",
                "type": "object",
                "properties": {
                  "min": {
                    "description": "Minimum value",
                    "type": "number"
                  },
                  "max": {
                    "description": "Maximum value",
                    "type": "number"
                  },
                  "minInclusive": {
                    "description": "Whether min is inclusive",
                    "type": "boolean"
                  },
                  "maxInclusive": {
                    "description": "Whether max is inclusive",
                    "type": "boolean"
                  }
                },
                "additionalProperties": false
              },
              "scopeConstraints": {
                "description": "Optional scope constraints",
                "type": "object",
                "properties": {
                  "caseClass": {
                    "description": "Case class filter",
                    "anyOf": [
                      {
                        "type": "string"
                      },
                      {
                        "type": "array",
                        "items": {
                          "type": "string"
                        }
                      }
                    ]
                  }
                },
                "additionalProperties": false
              },
              "tags": {
                "description": "Tags for filtering",
                "type": "array",
                "items": {
                  "type": "string"
                }
              }
            },
            "required": [
              "criterionId",
              "description",
              "type",
              "metric",
              "sut"
            ],
            "additionalProperties": false,
            "title": "MetricsCriterion",
            "description": "A metrics evaluation criterion"
          },
          "description": "Criteria to evaluate"
        }
      },
      "required": [
        "criteria"
      ],
      "additionalProperties": false,
      "title": "MetricsEvaluatorConfig",
      "description": "Configuration for the metrics evaluator"
    },
    "RobustnessEvaluatorConfig": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "type": "object",
      "properties": {
        "name": {
          "description": "Human-readable evaluator name",
          "type": "string"
        },
        "description": {
          "description": "Evaluator description",
          "type": "string"
        },
        "options": {
          "description": "Additional evaluator-specific options",
          "type": "object",
          "propertyNames": {
            "type": "string"
          },
          "additionalProperties": {}
        },
        "metrics": {
          "minItems": 1,
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "description": "Metrics to analyze"
        },
        "perturbations": {
          "minItems": 1,
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "description": "Perturbations applied"
        },
        "intensityLevels": {
          "description": "Intensity levels tested",
          "type": "array",
          "items": {
            "type": "number"
