{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "experiment": {
      "type": "object",
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "description": {
          "type": "string"
        },
        "version": {
          "type": "string"
        }
      },
      "required": [
        "name"
      ],
      "additionalProperties": false
    },
    "executor": {
      "type": "object",
      "properties": {
        "continueOnError": {
          "type": "boolean"
        },
        "repetitions": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "seedBase": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "timeoutMs": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "collectProvenance": {
          "type": "boolean"
        },
        "concurrency": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        }
      },
      "additionalProperties": false
    },
    "suts": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "module": {
            "type": "string",
            "minLength": 1
          },
          "exportName": {
            "type": "string",
            "minLength": 1
          },
          "config": {
            "type": "object",
            "propertyNames": {
              "type": "string"
            },
            "additionalProperties": {}
          },
          "type": {
            "type": "string",
            "enum": [
              "module",
              "binary"
            ]
          },
          "binaryCommand": {
            "type": "string"
          },
          "binaryArgs": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "binaryInputFormat": {
            "type": "string",
            "enum": [
              "json",
              "raw",
              "lines"
            ]
          },
          "binaryOutputFormat": {
            "type": "string",
            "enum": [
              "json",
              "raw",
              "lines"
            ]
          },
          "binaryTimeout": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          },
          "registration": {
            "type": "object",
            "properties": {
              "name": {
                "type": "string",
                "minLength": 1
              },
              "version": {
                "type": "string",
                "minLength": 1
              },
              "role": {
                "type": "string",
                "enum": [
                  "primary",
                  "baseline",
                  "oracle"
                ]
              },
              "tags": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "description": {
                "type": "string"
              }
            },
            "required": [
              "name",
              "version",
              "role"
            ],
            "additionalProperties": false
          }
        },
        "required": [
          "id",
          "module",
          "exportName",
          "registration"
        ],
        "additionalProperties": false
      }
    },
    "cases": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "module": {
            "type": "string",
            "minLength": 1
          },
          "exportName": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "id",
          "module",
          "exportName"
        ],
        "additionalProperties": false
      }
    },
    "metricsExtractor": {
      "type": "object",
      "properties": {
        "module": {
          "type": "string",
          "minLength": 1
        },
        "exportName": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "module",
        "exportName"
      ],
      "additionalProperties": false
    },
    "output": {
      "type": "object",
      "properties": {
        "path": {
          "type": "string"
        },
        "format": {
          "type": "string",
          "enum": [
            "json",
            "json-pretty"
          ]
        },
        "aggregate": {
          "type": "boolean"
        }
      },
      "additionalProperties": false
    }
  },
  "required": [
    "experiment",
    "executor",
    "suts",
    "cases",
    "metricsExtractor",
    "output"
  ],
  "additionalProperties": false
}
