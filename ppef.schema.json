        "significanceLevel": {
          "description": "Significance level for statistical tests (default: 0.05)",
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "minEffectSize": {
          "description": "Minimum effect size to consider meaningful",
          "type": "number",
          "minimum": 0
        },
        "computeCorrelations": {
          "description": "Whether to compute metric correlations",
          "type": "boolean"
        },
        "analyzeCaseClassEffects": {
